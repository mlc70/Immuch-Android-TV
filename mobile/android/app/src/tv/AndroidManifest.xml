<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <uses-feature android:name="android.software.leanback" android:required="true" tools:replace="android:required" />
  <!-- Exclude unsupported entry points, retaining shared platform APIs until audited. -->
  <application>
    <activity android:name=".immersive.ImmersiveViewerActivity" tools:node="remove" />
    <activity android:name=".spatial.SpatialVideoActivity" tools:node="remove" />
    <activity android:name=".widget.configure.RandomConfigure" tools:node="remove" />
    <receiver android:name=".widget.RandomReceiver" tools:node="remove" />
    <receiver android:name=".widget.MemoryReceiver" tools:node="remove" />
    <service android:name=".phoneshare.PhoneShareService" tools:node="remove" />
    <meta-data android:name="com.oculus.supportedDevices" tools:node="remove" />
    <meta-data android:name="com.oculus.handtracking.version" tools:node="remove" />
    <meta-data android:name="com.oculus.vr.focusaware" tools:node="remove" />
  </application>
</manifest>
